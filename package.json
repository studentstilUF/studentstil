{
  "name": "studentstil",
  "version": "1.0.0",
  "private": true,
  "description": "Webbshop för Studentstil – studentkläder och accessoarer med Swish-betalning.",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && oxlint --type-aware && oxfmt --check",
    "format": "oxfmt",
    "test": "vitest run",
    "hash-password": "node scripts/hashPassword.ts"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.2",
    "@types/node": "24.19.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.5"
}
