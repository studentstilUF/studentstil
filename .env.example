# =====================================================================
# Miljövariabler – MALL. Kopiera till ".env" för lokal utveckling.
# .env får ALDRIG läggas på GitHub (den står i .gitignore).
# I produktion läggs samma variabler in i Netlify:
#   Site configuration → Environment variables
# =====================================================================

# Sajtens adress (utan / på slutet). Lokalt: http://localhost:8888
SITE_URL=https://studentstil.se

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Den HEMLIGA nyckeln (sb_secret_… eller service_role). Ge den aldrig till någon.
SUPABASE_SERVICE_ROLE_KEY=

# --- Inloggning ---
# Lång slumpad sträng (minst 32 tecken). Skapa med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Skapa med: pnpm run hash-password  (klistra in hela raden som börjar med scrypt:)
ADMIN_PASSWORD_HASH=
# Valfritt demokonto (användarnamn "demo") som bara visar påhittad data
DEMO_PASSWORD_HASH=

# --- Swish ---
# manual = läge A (Swish Företag), commerce = läge B (Swish Handel)
SWISH_MODE=manual
# Ert Swish-nummer, 10 siffror
SWISH_PAYEE=1237051824

# Endast läge B (Swish Handel):
# SWISH_API_BASE=https://mss.cpc.getswish.net/swish-cpcapi   # testmiljö
# SWISH_API_BASE=https://cpc.getswish.net/swish-cpcapi       # skarp miljö
# SWISH_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SWISH_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SWISH_KEY_PASSPHRASE=
# SWISH_CA_PEM=

# --- E-post (Resend) ---
# Utan nyckel skrivs mejlen bara ut i terminalen (bra lokalt).
RESEND_API_KEY=
EMAIL_FROM=Studentstil <order@studentstil.se>
# Hit skickas notiser om nya ordrar
SHOP_EMAIL=studentstilkungsbacka@gmail.com

# --- GDPR ---
# Antal månader efter leverans innan kunduppgifter anonymiseras (standard 6)
DATA_RETENTION_MONTHS=6

# --- Frontend (byggs in i sidan, får INTE vara hemligt) ---
# Adress som QR-affischerna pekar på
VITE_SITE_URL=https://studentstil.se
